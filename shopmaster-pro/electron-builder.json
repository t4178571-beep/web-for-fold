{
  "appId": "com.shopmasterpro.app",
  "productName": "ShopMaster Pro",
  "directories": {
    "buildResources": "build"
  },
  "files": [
    "out/**/*"
  ],
  "win": {
    "target": "nsis"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "${productName} Setup ${version}.${ext}"
  }
}
